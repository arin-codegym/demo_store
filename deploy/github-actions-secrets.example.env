# Copy this file to github-actions-secrets.env and fill real values.
# github-actions-secrets.env is ignored by Git.

# EC2 SSH deployment
EC2_HOST=
EC2_INFRA_HOST=
EC2_BACKEND_NODE_HOST=
EC2_USER=ubuntu

# Docker Hub
DOCKERHUB_USERNAME=
DOCKERHUB_TOKEN=

# Frontend build-time values
SUPABASE_URL=
SUPABASE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_KEY=
API_EXTERNAL_BUILD=https://example.com/api/backend
NEXT_PUBLIC_BACKEND_URL_BUILD=https://example.com/api/backend

# Runtime mail values belong in PROD_ENV_FILE / deploy/prod.env, not frontend build args.
