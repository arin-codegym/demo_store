# Copy this file to prod.env and fill real production values.
# prod.env is ignored by Git and uploaded as GitHub secret PROD_ENV_FILE.

FRONTEND_TAG=latest
BACKEND_TAG=latest
FRONTEND_IMAGE=your-dockerhub/store-nextjs-frontend
BACKEND_IMAGE=your-dockerhub/store-springboot-backend

SPRING_DATASOURCE_URL=jdbc:postgresql://<rds-endpoint>:5432/<db>?sslmode=require
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

GEMINI_API_KEY=
JWT_SECRET=
REFRESH_HASH_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
APP_MAIL_ENABLED=true
APP_MAIL_FROM=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

FRONTEND_URL=https://example.com
NEXT_PUBLIC_BACKEND_URL=https://example.com/api/backend

SUPABASE_URL=
SUPABASE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_KEY=

AWS_REGION=ap-southeast-2
S3_PRODUCT_IMAGES_BUCKET=demo-store-product-images-prod-11111989
S3_PRODUCT_IMAGES_PUBLIC_BASE_URL=https://demo-store-product-images-prod-11111989.s3.ap-southeast-2.amazonaws.com

NEXT_REVALIDATE_PRODUCTS_URL=https://example.com/api/revalidate/products
NEXT_REVALIDATE_SECRET=
