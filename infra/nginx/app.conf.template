upstream backend_nodes {
    server 127.0.0.1:8080 max_fails=3 fail_timeout=10s;
    server __BACKEND_NODE_PRIVATE_IP__:8080 max_fails=3 fail_timeout=10s;
}

server {
    server_name quochuypaint.store www.quochuypaint.store;

    location /api/backend/ {
        proxy_pass http://backend_nodes;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /ws {
        proxy_pass http://backend_nodes;
        proxy_http_version 1.1;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/quochuypaint.store/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/quochuypaint.store/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot
}

server {
    if ($host = www.quochuypaint.store) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

    if ($host = quochuypaint.store) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

    listen 80;
    server_name quochuypaint.store www.quochuypaint.store;
    return 404; # managed by Certbot
}
