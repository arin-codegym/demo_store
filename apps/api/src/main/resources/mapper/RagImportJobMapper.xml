<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.quochuy.ai.rag.mapper.RagImportJobMapper">

    <resultMap id="RagImportJobResultMap" type="com.quochuy.ai.rag.model.RagImportJob">
        <id property="id" column="id"/>
        <result property="jobCode" column="job_code"/>
        <result property="fileName" column="file_name"/>
        <result property="sourceType" column="source_type"/>
        <result property="sourceUri" column="source_uri"/>
        <result property="status" column="status"/>
        <result property="totalDocuments" column="total_documents"/>
        <result property="successDocuments" column="success_documents"/>
        <result property="failedDocuments" column="failed_documents"/>
        <result property="errorMessage" column="error_message"/>
        <result property="startedAt" column="started_at"/>
        <result property="finishedAt" column="finished_at"/>
        <result property="createdBy" column="created_by"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <insert id="insert" parameterType="com.quochuy.ai.rag.model.RagImportJob"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO rag_import_job (
            job_code,
            file_name,
            source_type,
            source_uri,
            status,
            total_documents,
            success_documents,
            failed_documents,
            error_message,
            started_at,
            finished_at,
            created_by
        )
        VALUES (
                   #{jobCode},
                   #{fileName},
                   #{sourceType},
                   #{sourceUri},
                   #{status},
                   #{totalDocuments},
                   #{successDocuments},
                   #{failedDocuments},
                   #{errorMessage},
                   #{startedAt},
                   #{finishedAt},
                   #{createdBy}
               )
    </insert>
    <select id="findById" resultMap="RagImportJobResultMap">
        SELECT *
        FROM rag_import_job
        WHERE id = #{id}
    </select>

    <update id="markProcessing">
        UPDATE rag_import_job
        SET status = 'PROCESSING',
            started_at = CURRENT_TIMESTAMP
        WHERE id = #{id}
    </update>

    <update id="markCompleted">
        UPDATE rag_import_job
        SET status = 'COMPLETED',
            success_documents = #{successDocuments},
            failed_documents = #{failedDocuments},
            finished_at = CURRENT_TIMESTAMP
        WHERE id = #{id}
    </update>

    <update id="markFailed">
        UPDATE rag_import_job
        SET status = 'FAILED',
            failed_documents = #{failedDocuments},
            error_message = #{errorMessage},
            finished_at = CURRENT_TIMESTAMP
        WHERE id = #{id}
    </update>

</mapper>