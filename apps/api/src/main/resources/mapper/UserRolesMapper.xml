<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.quochuy.store.mapper.UserRolesMapper">

    <insert id="createRoleIsUser">
        INSERT INTO public.user_roles(user_id,
                                 role_id)
        VALUES (#{userId},3)
        ON CONFLICT DO NOTHING
    </insert>
    <delete id="deleteUserRoles">
        DELETE FROM public.user_roles
        WHERE user_id = #{userId}
    </delete>
    <insert id="insertUserRoles">
        INSERT INTO public.user_roles(user_id,
                                      role_id)
        VALUES
        <foreach collection="roles" item="r" separator=",">
            <choose>
                <when test="'ROLE_ADMIN'.equals(r)">
                    (#{userId}, 1)
                </when>
                <when test="'ROLE_MANAGER'.equals(r)">
                    (#{userId}, 2)
                </when>
                <otherwise>
                    (#{userId}, 3)
                </otherwise>
            </choose>
        </foreach>
    </insert>
</mapper>
